aws_region = "us-west-1"

# Run the controller on a permanent EC2 instance, or select "local" when a
# local T3 process coordinates the AWS workers.
controller_mode = "ec2"

# Set this to true for the one apply that changes an existing EC2 controller
# to local mode, then restore false.
allow_controller_data_destroy = false

# Keep this empty until CA-04 configures application authentication and TLS.
# Then add only the trusted networks that should reach the controller.
controller_ingress_cidrs = []

controller_instance_type        = "t3.small"
controller_root_volume_size_gib = 20
controller_data_volume_size_gib = 40

worker_default_ttl_minutes = 120
worker_profiles = {
  linux-web = {
    # Replace this with the AMI ID printed by the matching Packer build.
    ami_id               = "ami-0123456789abcdef0"
    image_version        = "0.0.42-ca27.1"
    instance_type        = "t3.medium"
    root_volume_size_gib = 30
    architecture         = "x86_64"
    capabilities         = ["coding", "web-preview"]
    desktop_dependencies = false
    shared_browser       = false
  }
  linux-web-browser = {
    # Build this AMI with profile_name=linux-web-browser,
    # install_desktop_dependencies=true, and install_shared_browser=true.
    ami_id               = "ami-0123456789abcdef0"
    image_version        = "0.0.42-ca35.1"
    instance_type        = "t3.medium"
    root_volume_size_gib = 30
    architecture         = "x86_64"
    capabilities         = ["coding", "web-preview", "shared-browser"]
    desktop_dependencies = true
    shared_browser       = true
  }
}

artifact_retention_days = 30

# Grant only the controller access to the existing SSH key and the GitHub API token.
# Use full Secrets Manager ARNs here, then set their secret names or ARNs in the
# controller's T3CODE_CLOUD_GIT_SSH_SECRET_REF and
# T3CODE_CLOUD_GITHUB_TOKEN_SECRET_REF environment variables.
controller_credential_secret_arns = []

# Choose one Codex mode. The API-key secret contains a raw OpenAI API key. The
# auth-json secret contains the complete auth.json from a ChatGPT account login
# and permits workers to persist refreshed credentials back to the same secret.
worker_codex_api_key_secret_arn = null
worker_codex_auth_json_secret_arn = null

# Store the raw value printed by `claude setup-token` in this secret.
worker_claude_oauth_token_secret_arn = null
