aws_region = "us-west-1"

# Run the controller on a permanent EC2 instance, or select "local" when a
# local T3 process coordinates the AWS workers.
controller_mode = "ec2"

# Set this to true for the one apply that changes an existing EC2 controller
# to local mode, then restore false.
allow_controller_data_destroy = false

# The permanent controller reaches clients over the tailnet, which supplies its
# stable name and renews its certificate. Leave controller_ingress_cidrs empty
# unless you also front the instance with a proxy you operate.
controller_ingress_cidrs = []

# The published CA-04C image. Pin a digest, not a moving tag: the host pulls it
# on every service start, so this value is what a rollback changes.
controller_image_ref = "123456789012.dkr.ecr.us-west-1.amazonaws.com/t3-controller@sha256:replace-me"

# Raw reusable, pre-approved Tailscale auth key for the permanent controller.
controller_tailscale_auth_key_secret_arn = null
controller_tailscale_hostname            = "t3-controller"
controller_tailnet_domain                = "example-tailnet.ts.net"

# Extra T3CODE_* settings for the controller container. Secret values belong in
# Secrets Manager; pass their names through a *_SECRET_REF entry.
controller_runtime_environment = {
  T3CODE_CLOUD_WORKER_ROUTE_URL = "https://{workerHostname}.example-tailnet.ts.net"
}

controller_instance_type        = "t3.small"
controller_root_volume_size_gib = 20
controller_data_volume_size_gib = 40

worker_default_ttl_minutes = 120
worker_profiles = {
  linux-web = {
    # Replace this with the AMI ID printed by the matching Packer build.
    ami_id               = "ami-0123456789abcdef0"
    image_version        = "0.0.42-ca27.1"
    instance_type        = "t3.medium"
    root_volume_size_gib = 30
    architecture         = "x86_64"
    capabilities         = ["coding", "web-preview"]
    desktop_dependencies = false
    shared_browser       = false
  }
  linux-web-browser = {
    # Build this AMI with profile_name=linux-web-browser,
    # install_desktop_dependencies=true, and install_shared_browser=true.
    ami_id               = "ami-0123456789abcdef0"
    image_version        = "0.0.42-ca35.1"
    instance_type        = "t3.medium"
    root_volume_size_gib = 30
    architecture         = "x86_64"
    capabilities         = ["coding", "web-preview", "shared-browser"]
    desktop_dependencies = true
    shared_browser       = true
  }
}

# Apple Silicon iOS Simulator workers. Leave empty until a Mac AMI exists.
# Hosts are allocated on demand; this map only declares the launch template.
mac_worker_profiles = {}

artifact_retention_days = 30

# Grant only the controller access to the existing SSH key and the GitHub API token.
# Use full Secrets Manager ARNs here, then set their secret names or ARNs in the
# controller's T3CODE_CLOUD_GIT_SSH_SECRET_REF and
# T3CODE_CLOUD_GITHUB_TOKEN_SECRET_REF environment variables.
controller_credential_secret_arns = []

# Root reads this key during cloud-init and clones the assigned repository. It
# deletes the key before T3 starts unless worker GitHub publishing is enabled.
worker_git_ssh_secret_arn = null

# Opt in to worker-side Git pushes and pull requests. The token needs repository
# contents and pull-request write access. This also keeps the SSH key available
# to the disposable task until the worker stops.
worker_github_token_secret_arn = null

# Choose one Codex mode. The API-key secret contains a raw OpenAI API key. The
# auth-json secret contains the complete auth.json from a ChatGPT account login
# and permits workers to persist refreshed credentials back to the same secret.
worker_codex_api_key_secret_arn = null
worker_codex_auth_json_secret_arn = null

# Store the raw value printed by `claude setup-token` in this secret.
worker_claude_oauth_token_secret_arn = null

# Raw reusable, ephemeral, pre-approved Tailscale auth key for disposable workers.
worker_tailscale_auth_key_secret_arn = null
