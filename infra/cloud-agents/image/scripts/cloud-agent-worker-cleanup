#!/bin/bash
set -euo pipefail

credentials_dir=/run/t3-worker/credentials
[[ -d "${credentials_dir}" ]] || exit 0

codex_auth="${credentials_dir}/codex/auth.json"
if [[ -f "${codex_auth}" ]] && jq --exit-status \
  '.auth_mode == "chatgpt" and (.tokens.refresh_token | type == "string" and length > 0)' \
  "${codex_auth}" >/dev/null; then
  pending_dir=/var/lib/t3-worker/provider-credentials
  if [[ -d "${pending_dir}" ]]; then
    pending_tmp="$(mktemp "${pending_dir}/.codex-auth-pending.XXXXXX")"
    cp "${codex_auth}" "${pending_tmp}"
    chmod 0600 "${pending_tmp}"
    mv "${pending_tmp}" "${pending_dir}/codex-auth-pending.json"
  fi
fi
