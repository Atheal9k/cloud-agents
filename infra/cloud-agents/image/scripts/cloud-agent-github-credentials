#!/bin/bash
set -euo pipefail

[[ "$#" -eq 4 ]] || {
  echo "usage: cloud-agent-github-credentials <region> <token-secret-arn> <bootstrap-credential-directory> <repository>" >&2
  exit 2
}

aws_region="$1"
token_secret_arn="$2"
bootstrap_credential_directory="$3"
repository="$4"
credential_directory=/run/t3-worker/credentials/github
runtime_environment=/run/t3-worker/runtime.env

[[ "${token_secret_arn}" =~ ^arn:[A-Za-z0-9-]+:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$ ]] || {
  echo "cloud-agent bootstrap failed: GitHub token secret ARN is invalid" >&2
  exit 1
}
[[ "${bootstrap_credential_directory}" == /run/t3-worker/repository-git.* ]] || {
  echo "cloud-agent bootstrap failed: Git credential directory is invalid" >&2
  exit 1
}
[[ "${repository}" == /work/repository && -d "${repository}/.git" ]] || {
  echo "cloud-agent bootstrap failed: Git repository workspace is invalid" >&2
  exit 1
}
[[ -f "${bootstrap_credential_directory}/github.key" && -f "${bootstrap_credential_directory}/known_hosts" ]] || {
  echo "cloud-agent bootstrap failed: Git push credential is unavailable" >&2
  exit 1
}
[[ ! -e "${credential_directory}" ]] || {
  echo "cloud-agent bootstrap failed: GitHub credential directory already exists" >&2
  exit 1
}

mv "${bootstrap_credential_directory}" "${credential_directory}"
cleanup() {
  rm -f -- \
    "${credential_directory}/secret" \
    "${credential_directory}/github.key" \
    "${credential_directory}/known_hosts"
  rmdir -- "${credential_directory}" 2>/dev/null || true
}
trap cleanup EXIT

if ! github_token_secret="$(
  aws secretsmanager get-secret-value \
    --region "${aws_region}" \
    --secret-id "${token_secret_arn}" \
    --query SecretString \
    --output text
)"; then
  echo "cloud-agent bootstrap failed: GitHub token secret is unavailable" >&2
  exit 1
fi
github_token="${github_token_secret}"
if [[ "${github_token_secret}" == \{* ]]; then
  if ! github_token="$(
    printf '%s' "${github_token_secret}" | jq --exit-status --raw-output \
      'if type == "object" and length == 1 then .[] else empty end | select(type == "string")'
  )"; then
    unset github_token_secret github_token
    echo "cloud-agent bootstrap failed: GitHub token secret is malformed" >&2
    exit 1
  fi
fi
unset github_token_secret
if [[ -z "${github_token}" || "${github_token}" == "None" || "${github_token}" =~ [[:space:]] || "${github_token}" == *"'"* ]]; then
  unset github_token
  echo "cloud-agent bootstrap failed: GitHub token secret is empty, binary, or malformed" >&2
  exit 1
fi

install -d -o cloudagent -g cloudagent -m 0700 /run/t3-worker
printf "GH_TOKEN='%s'\nGITHUB_TOKEN='%s'\n" \
  "${github_token}" "${github_token}" >>"${runtime_environment}"
unset github_token
chown root:cloudagent "${runtime_environment}"
chmod 0640 "${runtime_environment}"

git -C "${repository}" config --local core.sshCommand \
  "ssh -F /dev/null -i ${credential_directory}/github.key -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes -o StrictHostKeyChecking=yes -o HostKeyAlgorithms=ssh-ed25519 -o GlobalKnownHostsFile=/dev/null -o UserKnownHostsFile=${credential_directory}/known_hosts"
chown -R cloudagent:cloudagent "${credential_directory}"
trap - EXIT
