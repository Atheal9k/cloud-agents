#!/bin/bash
# Materializes this worker's provider credentials into its runtime directory.
#
# The runtime directory is tmpfs, so it is empty on every boot. Bootstrap runs
# once per instance, but a hibernated guest boots again when a follow-up wakes
# it, which is why this runs on every boot instead of inside cloud-init.
#
# It reads secret identifiers from /etc/t3/worker-credentials.env, never secret
# material, and writes nothing outside the runtime directory except the Codex
# sync marker the writeback timer compares against.
set -euo pipefail

fail() {
  echo "cloud-agent worker credentials failed: $*" >&2
  exit 1
}

environment_file=/etc/t3/worker-credentials.env
[[ -r "${environment_file}" ]] || fail "${environment_file} is unreadable"
# shellcheck disable=SC1090
source "${environment_file}"

aws_region="${AWS_REGION:-}"
codex_api_key_secret_arn="${T3_CODEX_API_KEY_SECRET_ARN:-}"
codex_auth_json_secret_arn="${T3_CODEX_AUTH_JSON_SECRET_ARN:-}"
claude_oauth_token_secret_arn="${T3_CLAUDE_OAUTH_TOKEN_SECRET_ARN:-}"
[[ -n "${aws_region}" ]] || fail "no AWS region is configured"

credentials_dir=/run/t3-worker/credentials
install -d -o cloudagent -g cloudagent -m 0700 /run/t3-worker "${credentials_dir}"

read_secret() {
  aws secretsmanager get-secret-value \
    --region "${aws_region}" \
    --secret-id "$1" \
    --query SecretString \
    --output text
}

if [[ -n "${codex_api_key_secret_arn}" ]]; then
  install -d -o cloudagent -g cloudagent -m 0700 "${credentials_dir}/codex"
  if ! codex_api_key="$(read_secret "${codex_api_key_secret_arn}")"; then
    find "${credentials_dir}/codex" -mindepth 1 -delete
    fail "Codex API key secret is unavailable"
  fi
  if [[ -z "${codex_api_key}" || "${codex_api_key}" == "None" ]]; then
    unset codex_api_key
    find "${credentials_dir}/codex" -mindepth 1 -delete
    fail "Codex API key secret is empty or binary"
  fi
  if ! printf '%s' "${codex_api_key}" | runuser --user cloudagent -- \
    env HOME=/home/cloudagent CODEX_HOME="${credentials_dir}/codex" \
    codex login --with-api-key >/dev/null; then
    unset codex_api_key
    find "${credentials_dir}/codex" -mindepth 1 -delete
    fail "Codex rejected the configured API key"
  fi
  unset codex_api_key
fi

if [[ -n "${codex_auth_json_secret_arn}" ]]; then
  install -d -o cloudagent -g cloudagent -m 0700 "${credentials_dir}/codex"
  install -d -o root -g cloudagent -m 0730 /var/lib/t3-worker/provider-credentials
  auth_tmp="$(mktemp "${credentials_dir}/codex/.auth.json.XXXXXX")"
  # A guest that hibernated staged its refreshed cache on the way down. It is
  # newer than the stored secret, so it wins when it is present and complete.
  pending_auth=/var/lib/t3-worker/provider-credentials/codex-auth-pending.json
  from_pending=0
  if [[ -f "${pending_auth}" ]]; then
    cp "${pending_auth}" "${auth_tmp}"
    from_pending=1
  elif ! read_secret "${codex_auth_json_secret_arn}" >"${auth_tmp}"; then
    rm -f "${auth_tmp}"
    find "${credentials_dir}/codex" -mindepth 1 -delete
    fail "Codex account secret is unavailable"
  fi
  if ! jq --exit-status \
    '.auth_mode == "chatgpt" and (.tokens.refresh_token | type == "string" and length > 0)' \
    "${auth_tmp}" >/dev/null; then
    rm -f "${auth_tmp}"
    find "${credentials_dir}/codex" -mindepth 1 -delete
    fail "Codex account credentials are not a refreshable ChatGPT auth.json"
  fi
  chown cloudagent:cloudagent "${auth_tmp}"
  chmod 0600 "${auth_tmp}"
  mv "${auth_tmp}" "${credentials_dir}/codex/auth.json"
  cat >"${credentials_dir}/codex/config.toml" <<'CODEX_CONFIG'
cli_auth_credentials_store = "file"
CODEX_CONFIG
  chown cloudagent:cloudagent "${credentials_dir}/codex/config.toml"
  chmod 0600 "${credentials_dir}/codex/config.toml"

  # The marker records what the secret holds. A cache restored from the staged
  # pending file is newer than the secret, so leaving the marker alone is what
  # lets the writeback timer upload it instead of reading it as already synced.
  if [[ "${from_pending}" -eq 0 ]]; then
    sha256sum "${credentials_dir}/codex/auth.json" \
      | awk '{ print $1 }' >/var/lib/t3-worker/provider-credentials/codex-auth-synced.sha256
    chmod 0600 /var/lib/t3-worker/provider-credentials/codex-auth-synced.sha256
  fi
  cat >/etc/t3/codex-auth-sync.env <<ENV
AWS_REGION=${aws_region}
T3_CODEX_AUTH_SECRET_ARN=${codex_auth_json_secret_arn}
ENV
  chmod 0600 /etc/t3/codex-auth-sync.env
fi

if [[ -n "${claude_oauth_token_secret_arn}" ]]; then
  if ! claude_oauth_token="$(read_secret "${claude_oauth_token_secret_arn}")"; then
    fail "Claude account secret is unavailable"
  fi
  if [[ -z "${claude_oauth_token}" || "${claude_oauth_token}" == "None" \
    || "${claude_oauth_token}" =~ [[:space:]] || "${claude_oauth_token}" == *"'"* ]]; then
    unset claude_oauth_token
    fail "Claude account secret is empty, binary, or malformed"
  fi
  runtime_env_tmp="$(mktemp /run/t3-worker/.runtime.env.XXXXXX)"
  printf "CLAUDE_CODE_OAUTH_TOKEN='%s'\n" "${claude_oauth_token}" >"${runtime_env_tmp}"
  unset claude_oauth_token
  chown root:cloudagent "${runtime_env_tmp}"
  chmod 0640 "${runtime_env_tmp}"
  mv "${runtime_env_tmp}" /run/t3-worker/runtime.env
fi
