[Unit]
Description=Watch for refreshed Codex account credentials
ConditionPathExists=/etc/t3/codex-auth-sync.env

[Path]
PathChanged=/run/t3-worker/credentials/codex/auth.json
PathChanged=/var/lib/t3-worker/provider-credentials/codex-auth-pending.json
Unit=cloud-agent-codex-auth-sync.service

[Install]
WantedBy=multi-user.target
