[Unit]
Description=T3 disposable cloud worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/t3/worker.env

[Service]
Type=simple
User=cloudagent
Group=cloudagent
WorkingDirectory=/work
Environment=HOME=/home/cloudagent
Environment=CLAUDE_CONFIG_DIR=/run/t3-worker/credentials/claude
Environment=CODEX_HOME=/run/t3-worker/credentials/codex
Environment=DISABLE_AUTOUPDATER=1
Environment=NODE_ENV=production
Environment=T3CODE_AUTO_BOOTSTRAP_PROJECT_FROM_CWD=0
Environment=T3CODE_HOME=/var/lib/t3-worker/t3
Environment=T3CODE_HOST=0.0.0.0
Environment=T3CODE_NO_BROWSER=1
Environment=T3CODE_PORT=3773
EnvironmentFile=-/etc/t3/worker.env
EnvironmentFile=-/run/t3-worker/runtime.env
RuntimeDirectory=t3-worker
RuntimeDirectoryMode=0700
StateDirectory=t3-worker
StateDirectoryMode=0700
ExecStartPre=/opt/t3/bin/cloud-agent-worker-preflight
ExecStart=/usr/local/bin/t3 serve /work
ExecStopPost=/opt/t3/bin/cloud-agent-worker-cleanup
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/t3-worker /run/t3-worker /work
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=169.254.169.254/32
IPAddressDeny=fd00:ec2::254/128

[Install]
WantedBy=multi-user.target
