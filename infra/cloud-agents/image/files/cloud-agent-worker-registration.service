[Unit]
Description=Register this T3 worker with its allocation controller
After=network-online.target cloud-agent-worker.service
Wants=network-online.target
Requires=cloud-agent-worker.service

[Service]
Type=oneshot
User=cloudagent
Group=cloudagent
Environment=HOME=/home/cloudagent
ExecStart=/opt/t3/bin/cloud-agent-worker-register
Restart=on-failure
RestartSec=5s
TimeoutStartSec=2m

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/t3-worker
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
