#!/bin/bash
set -euo pipefail

manifest=/opt/t3/worker-image-manifest.json
if [[ ! -r "$manifest" ]]; then
  echo "cloud-agent bootstrap failed: worker image manifest is missing" >&2
  exit 1
fi

if ! jq --exit-status \
  --arg profile '${profile_name}' \
  --arg image_version '${image_version}' \
  '.profile == $profile and .imageVersion == $image_version' \
  "$manifest" >/dev/null; then
  echo "cloud-agent bootstrap failed: image profile or version does not match the launch template" >&2
  exit 1
fi

install -d -o root -g cloudagent -m 0750 /etc/t3
install -d -o cloudagent -g cloudagent -m 0700 /run/t3-worker/credentials

metadata_base='http://169.254.169.254/latest'
metadata_token="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --request PUT \
    --header 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
    "$${metadata_base}/api/token"
)"
max_input_wait_seconds="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentMaxInputWaitSeconds"
)"
allocation_id="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentAllocationId"
)"
attempt="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentAttempt"
)"
worker_route_url="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentWorkerRouteUrl"
)"
repository="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentRepository"
)"
selected_ref="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentSelectedRef"
)"
output_branch="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentOutputBranch"
)"
[[ "$${max_input_wait_seconds}" =~ ^[1-9][0-9]*$ ]] || {
  echo "cloud-agent bootstrap failed: input-wait limit tag is invalid" >&2
  exit 1
}
[[ "$${allocation_id}" =~ ^[A-Za-z0-9_-]{1,128}$ ]] || {
  echo "cloud-agent bootstrap failed: allocation id tag is invalid" >&2
  exit 1
}
[[ "$${attempt}" =~ ^[1-9][0-9]*$ ]] || {
  echo "cloud-agent bootstrap failed: attempt tag is invalid" >&2
  exit 1
}
[[ "$${repository}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || {
  echo "cloud-agent bootstrap failed: repository tag is invalid" >&2
  exit 1
}
if [[ ! "$${selected_ref}" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$ ]] ||
  [[ "$${selected_ref}" == *..* || "$${selected_ref}" == *"@{"* || "$${selected_ref}" == *//* ]]; then
  echo "cloud-agent bootstrap failed: selected ref tag is invalid" >&2
  exit 1
fi
if ! git check-ref-format --branch "$${output_branch}" >/dev/null 2>&1; then
  echo "cloud-agent bootstrap failed: output branch tag is invalid" >&2
  exit 1
fi

cat >/etc/t3/worker.env.pending <<ENV
T3_WORKER_PROFILE=${profile_name}
T3_WORKER_IMAGE_VERSION=${image_version}
T3CODE_CLOUD_MAX_INPUT_WAIT_SECONDS=$${max_input_wait_seconds}
T3CODE_PORT=${service_port}
T3CODE_SHARED_BROWSER_THREAD_ID=thread-$${allocation_id}-$${attempt}
T3CODE_SHARED_BROWSER_ATTEMPT_KEY=$${allocation_id}:$${attempt}
T3CODE_DEVICE_DISPLAY_THREAD_ID=thread-$${allocation_id}-$${attempt}
T3CODE_DEVICE_DISPLAY_ATTEMPT_KEY=$${allocation_id}:$${attempt}
ENV
if jq --exit-status '.capabilities.desktopStreamService == true' "$manifest" >/dev/null; then
  echo 'T3CODE_SHARED_BROWSER_COMMAND=/opt/t3/bin/cloud-agent-shared-browser' \
    >>/etc/t3/worker.env.pending
  echo 'T3CODE_SHARED_BROWSER_PERMISSION_COMMAND=/opt/t3/bin/cloud-agent-shared-browser-permissions' \
    >>/etc/t3/worker.env.pending
fi
if jq --exit-status '.capabilities.deviceDisplayService == "android"' "$manifest" >/dev/null; then
  echo 'T3CODE_DEVICE_DISPLAY_PLATFORM=android' >>/etc/t3/worker.env.pending
  echo 'T3CODE_DEVICE_DISPLAY_COMMAND=/opt/t3/bin/cloud-agent-device-display' \
    >>/etc/t3/worker.env.pending
  echo 'T3CODE_DEVICE_DISPLAY_PERMISSION_COMMAND=/opt/t3/bin/cloud-agent-device-display-permissions' \
    >>/etc/t3/worker.env.pending
fi
chown root:cloudagent /etc/t3/worker.env.pending
chmod 0640 /etc/t3/worker.env.pending

codex_api_key_secret_arn='${codex_api_key_secret_arn}'
codex_auth_json_secret_arn='${codex_auth_json_secret_arn}'
claude_oauth_token_secret_arn='${claude_oauth_token_secret_arn}'
git_ssh_secret_arn='${git_ssh_secret_arn}'
github_token_secret_arn='${github_token_secret_arn}'
tailscale_auth_key_secret_arn='${tailscale_auth_key_secret_arn}'
if [[ -n "$${codex_api_key_secret_arn}" || -n "$${codex_auth_json_secret_arn}" || -n "$${claude_oauth_token_secret_arn}" || -n "$${git_ssh_secret_arn}" || -n "$${github_token_secret_arn}" || -n "$${tailscale_auth_key_secret_arn}" ]]; then
  command -v aws >/dev/null || {
    echo "cloud-agent bootstrap failed: AWS CLI is unavailable for worker credentials" >&2
    exit 1
  }
fi

# Provider credentials live in a runtime directory that is empty on every boot,
# and this script only runs on the first one. Materializing them from a unit
# instead means a guest that hibernated and was woken comes back able to run a
# provider turn rather than with an empty provider home.
cat >/etc/t3/worker-credentials.env <<ENV
AWS_REGION=${aws_region}
T3_CODEX_API_KEY_SECRET_ARN=$${codex_api_key_secret_arn}
T3_CODEX_AUTH_JSON_SECRET_ARN=$${codex_auth_json_secret_arn}
T3_CLAUDE_OAUTH_TOKEN_SECRET_ARN=$${claude_oauth_token_secret_arn}
ENV
chmod 0600 /etc/t3/worker-credentials.env
if ! systemctl enable --now cloud-agent-worker-credentials.service; then
  systemctl status --no-pager --full cloud-agent-worker-credentials.service >&2 || true
  journalctl --no-pager --unit cloud-agent-worker-credentials.service --lines 50 >&2 || true
  echo "cloud-agent bootstrap failed: worker provider credentials are unavailable" >&2
  exit 1
fi

/opt/t3/bin/cloud-agent-prepare-repository \
  '${aws_region}' \
  "$${repository}" \
  "$${selected_ref}" \
  "$${output_branch}" \
  "$${allocation_id}" \
  "$${attempt}" \
  "$${git_ssh_secret_arn}" \
  "$${github_token_secret_arn}"

cat >/etc/systemd/system/cloud-agent-hard-ttl.service <<'UNIT'
[Unit]
Description=Terminate this disposable worker after its hard lifetime

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-run --unit cloud-agent-hard-stop --on-active=${ttl_minutes}m /sbin/shutdown -h now
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now amazon-ssm-agent.service
systemctl enable --now cloud-agent-hard-ttl.service
if [[ -f /etc/t3/codex-auth-sync.env ]]; then
  systemctl enable --now cloud-agent-codex-auth-sync.path
  systemctl enable --now cloud-agent-codex-auth-sync.timer
fi
mv /etc/t3/worker.env.pending /etc/t3/worker.env
systemctl enable cloud-agent-worker.service

service_started_ms="$(date +%s%3N)"
uptime_ms="$(awk '{ printf "%.0f", $1 * 1000 }' /proc/uptime)"
boot_started_ms="$((service_started_ms - uptime_ms))"
node -e '
  const fs = require("node:fs");
  const [file, bootStartedMs, serviceStartedMs] = process.argv.slice(1);
  fs.writeFileSync(file, `$${JSON.stringify({
    bootStartedMs: Number(bootStartedMs),
    bootCompletedMs: Number(serviceStartedMs),
    serviceStartedMs: Number(serviceStartedMs)
  })}\n`, { mode: 0o640 });
' /var/lib/t3-worker/startup-timings.pending.json "$${boot_started_ms}" "$${service_started_ms}"
chown root:cloudagent /var/lib/t3-worker/startup-timings.pending.json
if ! systemctl start cloud-agent-worker.service; then
  systemctl status --no-pager --full cloud-agent-worker.service >&2 || true
  journalctl --no-pager --unit cloud-agent-worker.service --lines 100 >&2 || true
  exit 1
fi

if [[ -n "$${tailscale_auth_key_secret_arn}" ]]; then
  command -v tailscale >/dev/null || {
    echo "cloud-agent bootstrap failed: Tailscale is unavailable" >&2
    exit 1
  }
  if ! worker_hostname="$(
    node -e '
      const url = new URL(process.argv[1]);
      if (
        url.protocol !== "https:" ||
        url.username !== "" ||
        url.password !== "" ||
        url.port !== "" ||
        url.pathname !== "/" ||
        url.search !== "" ||
        url.hash !== "" ||
        !/^t3-worker-[0-9a-f]{16}\.[a-z0-9.-]+$/i.test(url.hostname)
      ) process.exit(1);
      process.stdout.write(url.hostname.split(".")[0]);
    ' "$${worker_route_url}"
  )"; then
    echo "cloud-agent bootstrap failed: worker route is not a valid Tailscale HTTPS hostname" >&2
    exit 1
  fi

  install -d -o root -g root -m 0700 /run/t3-tailscale
  tailscale_auth_key_file="$(mktemp /run/t3-tailscale/auth-key.XXXXXX)"
  cleanup_tailscale_auth_key() {
    rm -f "$${tailscale_auth_key_file}"
    rmdir /run/t3-tailscale 2>/dev/null || true
  }
  trap cleanup_tailscale_auth_key EXIT
  if ! aws secretsmanager get-secret-value \
    --region '${aws_region}' \
    --secret-id "$${tailscale_auth_key_secret_arn}" \
    --query SecretString \
    --output text >"$${tailscale_auth_key_file}"; then
    echo "cloud-agent bootstrap failed: Tailscale auth key secret is unavailable" >&2
    exit 1
  fi
  chmod 0600 "$${tailscale_auth_key_file}"
  if ! grep --quiet --extended-regexp '^tskey-auth-[A-Za-z0-9_-]+(-[A-Za-z0-9_-]+)?$' "$${tailscale_auth_key_file}"; then
    echo "cloud-agent bootstrap failed: Tailscale auth key secret is empty, binary, or malformed" >&2
    exit 1
  fi

  systemctl enable --now tailscaled.service
  tailscale up \
    --accept-dns=true \
    --auth-key="file:$${tailscale_auth_key_file}" \
    --hostname="$${worker_hostname}" \
    --timeout=60s
  cleanup_tailscale_auth_key
  trap - EXIT
  tailscale serve --bg --yes --https=443 "http://127.0.0.1:${service_port}"
fi

systemctl enable --now cloud-agent-worker-registration.service
