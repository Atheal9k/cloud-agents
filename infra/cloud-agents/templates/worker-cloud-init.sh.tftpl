#!/bin/bash
set -euo pipefail

manifest=/opt/t3/worker-image-manifest.json
if [[ ! -r "$manifest" ]]; then
  echo "cloud-agent bootstrap failed: worker image manifest is missing" >&2
  exit 1
fi

if ! jq --exit-status \
  --arg profile '${profile_name}' \
  --arg image_version '${image_version}' \
  '.profile == $profile and .imageVersion == $image_version' \
  "$manifest" >/dev/null; then
  echo "cloud-agent bootstrap failed: image profile or version does not match the launch template" >&2
  exit 1
fi

install -d -o root -g cloudagent -m 0750 /etc/t3

metadata_base='http://169.254.169.254/latest'
metadata_token="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --request PUT \
    --header 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
    "$${metadata_base}/api/token"
)"
max_input_wait_seconds="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentMaxInputWaitSeconds"
)"
allocation_id="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentAllocationId"
)"
attempt="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentAttempt"
)"
[[ "$${max_input_wait_seconds}" =~ ^[1-9][0-9]*$ ]] || {
  echo "cloud-agent bootstrap failed: input-wait limit tag is invalid" >&2
  exit 1
}
[[ "$${allocation_id}" =~ ^[A-Za-z0-9_-]{1,128}$ ]] || {
  echo "cloud-agent bootstrap failed: allocation id tag is invalid" >&2
  exit 1
}
[[ "$${attempt}" =~ ^[1-9][0-9]*$ ]] || {
  echo "cloud-agent bootstrap failed: attempt tag is invalid" >&2
  exit 1
}

cat >/etc/t3/worker.env <<ENV
T3_WORKER_PROFILE=${profile_name}
T3_WORKER_IMAGE_VERSION=${image_version}
T3CODE_CLOUD_MAX_INPUT_WAIT_SECONDS=$${max_input_wait_seconds}
T3CODE_PORT=${service_port}
T3CODE_SHARED_BROWSER_THREAD_ID=thread-$${allocation_id}-$${attempt}
T3CODE_SHARED_BROWSER_ATTEMPT_KEY=$${allocation_id}:$${attempt}
ENV
if jq --exit-status '.capabilities.desktopStreamService == true' "$manifest" >/dev/null; then
  echo 'T3CODE_SHARED_BROWSER_COMMAND=/opt/t3/bin/cloud-agent-shared-browser' \
    >>/etc/t3/worker.env
  echo 'T3CODE_SHARED_BROWSER_PERMISSION_COMMAND=/opt/t3/bin/cloud-agent-shared-browser-permissions' \
    >>/etc/t3/worker.env
fi
chown root:cloudagent /etc/t3/worker.env
chmod 0640 /etc/t3/worker.env

codex_api_key_secret_arn='${codex_api_key_secret_arn}'
codex_auth_json_secret_arn='${codex_auth_json_secret_arn}'
claude_oauth_token_secret_arn='${claude_oauth_token_secret_arn}'
if [[ -n "$${codex_api_key_secret_arn}" || -n "$${codex_auth_json_secret_arn}" || -n "$${claude_oauth_token_secret_arn}" ]]; then
  command -v aws >/dev/null || {
    echo "cloud-agent bootstrap failed: AWS CLI is unavailable for provider authentication" >&2
    exit 1
  }
fi

if [[ -n "$${codex_api_key_secret_arn}" ]]; then
  install -d -o cloudagent -g cloudagent -m 0700 /run/t3-worker/credentials/codex
  if ! codex_api_key="$(
    aws secretsmanager get-secret-value \
      --region '${aws_region}' \
      --secret-id "$${codex_api_key_secret_arn}" \
      --query SecretString \
      --output text
  )"; then
    find /run/t3-worker/credentials/codex -mindepth 1 -delete
    echo "cloud-agent bootstrap failed: Codex API key secret is unavailable" >&2
    exit 1
  fi
  if [[ -z "$${codex_api_key}" || "$${codex_api_key}" == "None" ]]; then
    unset codex_api_key
    find /run/t3-worker/credentials/codex -mindepth 1 -delete
    echo "cloud-agent bootstrap failed: Codex API key secret is empty or binary" >&2
    exit 1
  fi
  if ! printf '%s' "$${codex_api_key}" | runuser --user cloudagent -- \
    env HOME=/home/cloudagent CODEX_HOME=/run/t3-worker/credentials/codex \
    codex login --with-api-key >/dev/null; then
    unset codex_api_key
    find /run/t3-worker/credentials/codex -mindepth 1 -delete
    echo "cloud-agent bootstrap failed: Codex rejected the configured API key" >&2
    exit 1
  fi
  unset codex_api_key
fi

if [[ -n "$${codex_auth_json_secret_arn}" ]]; then
  install -d -o cloudagent -g cloudagent -m 0700 /run/t3-worker/credentials/codex
  codex_auth_json_tmp="$(mktemp /run/t3-worker/credentials/codex/.auth.json.XXXXXX)"
  if ! aws secretsmanager get-secret-value \
    --region '${aws_region}' \
    --secret-id "$${codex_auth_json_secret_arn}" \
    --query SecretString \
    --output text >"$${codex_auth_json_tmp}"; then
    rm -f "$${codex_auth_json_tmp}"
    find /run/t3-worker/credentials/codex -mindepth 1 -delete
    echo "cloud-agent bootstrap failed: Codex account secret is unavailable" >&2
    exit 1
  fi
  if ! jq --exit-status \
    '.auth_mode == "chatgpt" and (.tokens.refresh_token | type == "string" and length > 0)' \
    "$${codex_auth_json_tmp}" >/dev/null; then
    rm -f "$${codex_auth_json_tmp}"
    find /run/t3-worker/credentials/codex -mindepth 1 -delete
    echo "cloud-agent bootstrap failed: Codex account secret is not a refreshable ChatGPT auth.json" >&2
    exit 1
  fi
  chown cloudagent:cloudagent "$${codex_auth_json_tmp}"
  chmod 0600 "$${codex_auth_json_tmp}"
  mv "$${codex_auth_json_tmp}" /run/t3-worker/credentials/codex/auth.json
  cat >/run/t3-worker/credentials/codex/config.toml <<'CODEX_CONFIG'
cli_auth_credentials_store = "file"
CODEX_CONFIG
  chown cloudagent:cloudagent /run/t3-worker/credentials/codex/config.toml
  chmod 0600 /run/t3-worker/credentials/codex/config.toml

  install -d -o root -g cloudagent -m 0730 /var/lib/t3-worker/provider-credentials
  sha256sum /run/t3-worker/credentials/codex/auth.json \
    | awk '{ print $1 }' >/var/lib/t3-worker/provider-credentials/codex-auth-synced.sha256
  chmod 0600 /var/lib/t3-worker/provider-credentials/codex-auth-synced.sha256
  cat >/etc/t3/codex-auth-sync.env <<ENV
AWS_REGION=${aws_region}
T3_CODEX_AUTH_SECRET_ARN=$${codex_auth_json_secret_arn}
ENV
  chmod 0600 /etc/t3/codex-auth-sync.env
fi

if [[ -n "$${claude_oauth_token_secret_arn}" ]]; then
  if ! claude_oauth_token="$(
    aws secretsmanager get-secret-value \
      --region '${aws_region}' \
      --secret-id "$${claude_oauth_token_secret_arn}" \
      --query SecretString \
      --output text
  )"; then
    echo "cloud-agent bootstrap failed: Claude account secret is unavailable" >&2
    exit 1
  fi
  if [[ -z "$${claude_oauth_token}" || "$${claude_oauth_token}" == "None" || "$${claude_oauth_token}" =~ [[:space:]] || "$${claude_oauth_token}" == *"'"* ]]; then
    unset claude_oauth_token
    echo "cloud-agent bootstrap failed: Claude account secret is empty, binary, or malformed" >&2
    exit 1
  fi
  install -d -o cloudagent -g cloudagent -m 0700 /run/t3-worker
  printf "CLAUDE_CODE_OAUTH_TOKEN='%s'\n" "$${claude_oauth_token}" >/run/t3-worker/runtime.env
  unset claude_oauth_token
  chown root:cloudagent /run/t3-worker/runtime.env
  chmod 0640 /run/t3-worker/runtime.env
fi

cat >/etc/systemd/system/cloud-agent-hard-ttl.service <<'UNIT'
[Unit]
Description=Terminate this disposable worker after its hard lifetime

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-run --unit cloud-agent-hard-stop --on-active=${ttl_minutes}m /sbin/shutdown -h now
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now amazon-ssm-agent.service
systemctl enable --now cloud-agent-hard-ttl.service
if [[ -f /etc/t3/codex-auth-sync.env ]]; then
  systemctl enable --now cloud-agent-codex-auth-sync.path
  systemctl enable --now cloud-agent-codex-auth-sync.timer
fi
systemctl enable cloud-agent-worker.service

service_started_ms="$(date +%s%3N)"
uptime_ms="$(awk '{ printf "%.0f", $1 * 1000 }' /proc/uptime)"
boot_started_ms="$((service_started_ms - uptime_ms))"
node -e '
  const fs = require("node:fs");
  const [file, bootStartedMs, serviceStartedMs] = process.argv.slice(1);
  fs.writeFileSync(file, `$${JSON.stringify({
    bootStartedMs: Number(bootStartedMs),
    bootCompletedMs: Number(serviceStartedMs),
    serviceStartedMs: Number(serviceStartedMs)
  })}\n`, { mode: 0o640 });
' /var/lib/t3-worker/startup-timings.pending.json "$${boot_started_ms}" "$${service_started_ms}"
chown root:cloudagent /var/lib/t3-worker/startup-timings.pending.json
systemctl start cloud-agent-worker.service
systemctl enable --now cloud-agent-worker-registration.service
