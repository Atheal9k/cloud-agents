#!/bin/bash
set -euo pipefail

manifest=/opt/t3/worker-image-manifest.json
if [[ ! -r "$manifest" ]]; then
  echo "cloud-agent bootstrap failed: worker image manifest is missing" >&2
  exit 1
fi

if ! jq --exit-status \
  --arg profile '${profile_name}' \
  --arg image_version '${image_version}' \
  '.profile == $profile and .imageVersion == $image_version' \
  "$manifest" >/dev/null; then
  echo "cloud-agent bootstrap failed: image profile or version does not match the launch template" >&2
  exit 1
fi

install -d -o root -g cloudagent -m 0750 /etc/t3

metadata_base='http://169.254.169.254/latest'
metadata_token="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --request PUT \
    --header 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
    "$${metadata_base}/api/token"
)"
max_input_wait_seconds="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentMaxInputWaitSeconds"
)"
allocation_id="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentAllocationId"
)"
attempt="$(
  curl --noproxy '*' --silent --show-error --fail --max-time 5 \
    --header "X-aws-ec2-metadata-token: $${metadata_token}" \
    "$${metadata_base}/meta-data/tags/instance/CloudAgentAttempt"
)"
[[ "$${max_input_wait_seconds}" =~ ^[1-9][0-9]*$ ]] || {
  echo "cloud-agent bootstrap failed: input-wait limit tag is invalid" >&2
  exit 1
}
[[ "$${allocation_id}" =~ ^[A-Za-z0-9_-]{1,128}$ ]] || {
  echo "cloud-agent bootstrap failed: allocation id tag is invalid" >&2
  exit 1
}
[[ "$${attempt}" =~ ^[1-9][0-9]*$ ]] || {
  echo "cloud-agent bootstrap failed: attempt tag is invalid" >&2
  exit 1
}

cat >/etc/t3/worker.env <<ENV
T3_WORKER_PROFILE=${profile_name}
T3_WORKER_IMAGE_VERSION=${image_version}
T3CODE_CLOUD_MAX_INPUT_WAIT_SECONDS=$${max_input_wait_seconds}
T3CODE_PORT=${service_port}
T3CODE_SHARED_BROWSER_THREAD_ID=thread-$${allocation_id}-$${attempt}
T3CODE_SHARED_BROWSER_ATTEMPT_KEY=$${allocation_id}:$${attempt}
ENV
if jq --exit-status '.capabilities.desktopStreamService == true' "$manifest" >/dev/null; then
  echo 'T3CODE_SHARED_BROWSER_COMMAND=/opt/t3/bin/cloud-agent-shared-browser' \
    >>/etc/t3/worker.env
  echo 'T3CODE_SHARED_BROWSER_PERMISSION_COMMAND=/opt/t3/bin/cloud-agent-shared-browser-permissions' \
    >>/etc/t3/worker.env
fi
chown root:cloudagent /etc/t3/worker.env
chmod 0640 /etc/t3/worker.env

cat >/etc/systemd/system/cloud-agent-hard-ttl.service <<'UNIT'
[Unit]
Description=Terminate this disposable worker after its hard lifetime

[Service]
Type=oneshot
ExecStart=/usr/bin/systemd-run --unit cloud-agent-hard-stop --on-active=${ttl_minutes}m /sbin/shutdown -h now
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now amazon-ssm-agent.service
systemctl enable --now cloud-agent-hard-ttl.service
systemctl enable cloud-agent-worker.service

service_started_ms="$(date +%s%3N)"
uptime_ms="$(awk '{ printf "%.0f", $1 * 1000 }' /proc/uptime)"
boot_started_ms="$((service_started_ms - uptime_ms))"
node -e '
  const fs = require("node:fs");
  const [file, bootStartedMs, serviceStartedMs] = process.argv.slice(1);
  fs.writeFileSync(file, `$${JSON.stringify({
    bootStartedMs: Number(bootStartedMs),
    bootCompletedMs: Number(serviceStartedMs),
    serviceStartedMs: Number(serviceStartedMs)
  })}\n`, { mode: 0o640 });
' /var/lib/t3-worker/startup-timings.pending.json "$${boot_started_ms}" "$${service_started_ms}"
chown root:cloudagent /var/lib/t3-worker/startup-timings.pending.json
systemctl start cloud-agent-worker.service
systemctl enable --now cloud-agent-worker-registration.service
